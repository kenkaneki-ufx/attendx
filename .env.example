# AttendX Environment Variables
# Copy this to .env and fill in your values

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=false

# Database (Render provides DATABASE_URL automatically)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Host Configuration
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=AttendX <noreply@yourdomain.com>

# Redis Cache (Optional - Render provides Redis)
REDIS_URL=redis://red-xxxxx:6379

# QR Code Settings
QR_EXPIRY_SECONDS=60

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Password Reset
PASSWORD_RESET_BASE_URL=https://your-app-name.onrender.com
